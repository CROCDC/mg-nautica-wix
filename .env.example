# ─────────────────────────────────────────────────────────────────────────────
# MG Náutica storefront — environment variables
# Copy to .env.local (gitignored) and fill in. In production these live in Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# Wix OAuth public client id (visitor tokens for catalog/cart). NOT a secret —
# exposed to the browser, hence the NEXT_PUBLIC_ prefix.
# Get it in the Wix dashboard → Settings → Headless → create an OAuth app.
NEXT_PUBLIC_WIX_CLIENT_ID=

# Wix site identifiers (from the live site; see plan §5). The admin client sends
# WIX_SITE_ID as `wix-site-id`, which Wix resolves only against the meta site id —
# 11bbc77b-… (the Stores instance) answers "MetaSite not found".
WIX_SITE_ID=90eb2d0e-cc22-422c-a42e-602fd3422f13
WIX_META_SITE_ID=90eb2d0e-cc22-422c-a42e-602fd3422f13

# Server-only Wix API key (NEVER exposed to the browser). The catalog runs without it;
# the newsletter (/newsletter) needs it to write subscribers into the Wix CRM and the
# alerts need it to read them back and keep their log, with the "Manage Contacts",
# "Email Subscriptions" and "Wix Data" permissions (docs/NEWSLETTER-PLAN.md §5).
# Without it the form answers "not available yet" instead of subscribing.
WIX_API_KEY=

# ─── Newsletter alerts by WhatsApp (docs/NEWSLETTER-PLAN.md §6) ──────────────
# All server-only. Without WHATSAPP_TOKEN + WHATSAPP_PHONE_NUMBER_ID the alert run
# refuses to start (it would otherwise burn alerts it cannot send).
# Shared secret of the scheduled run: GitHub Actions sends it as a Bearer token.
CRON_SECRET=
# Meta → WhatsApp → API Setup: a permanent System User token and the sender's number id.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app → Settings → Basic → App secret (signs the webhook deliveries).
WHATSAPP_APP_SECRET=
# Any string; typed again in Meta when subscribing the webhook.
WHATSAPP_VERIFY_TOKEN=
# Optional overrides (defaults shown).
# WHATSAPP_TEMPLATE=alerta_modelo
# WHATSAPP_TEMPLATE_LANG=es_AR
# WHATSAPP_API_VERSION=v24.0

# ─── Deploy (set as GitHub Actions secrets, not here) ────────────────────────
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID — used by .github/workflows/deploy.yml
# CRON_SECRET (same value as above) + repo variable ALERTS_ENABLED=true — alerts.yml
